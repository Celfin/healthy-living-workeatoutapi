# Copy to .env on the server and fill in real values: cp .env.example .env
# Do NOT commit .env

DB_NAME=healthy_living
DB_USERNAME=healthy
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-different-strong-password

# Host port the API is published on
API_PORT=8089

# Use "validate" or "none" once your schema is stable
JPA_DDL_AUTO=update
